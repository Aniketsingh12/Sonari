# ======================================================================
# Sonari backend configuration
# Copy to `.env`. Everything here has a working default — the app runs
# with ZERO changes using built-in mock providers (no keys, no downloads).
# ======================================================================

ENVIRONMENT=development
DEBUG=true
PUBLIC_BASE_URL=http://localhost:8100
CORS_ORIGINS=http://localhost:5273,http://localhost:3000

# ---- Dashboard password ----
# Empty = the owner dashboard is OPEN (handy locally, unsafe in public).
# ALWAYS set this on a deployment: without it anyone with the URL can read,
# edit and delete every agent. Public voice-agent links never need it.
ADMIN_PASSWORD=

# ---- Database (SQLite by default; swap for Postgres/Supabase) ----
DATABASE_URL=sqlite+aiosqlite:///./sonari.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/sonari

# ---- Redis / Celery (optional; only for background workers) ----
REDIS_URL=redis://localhost:6379/0

# ======================================================================
# AI PROVIDER SELECTION  —  mix and match open-source and paid per layer
# ======================================================================
# STT:  mock | faster_whisper (open-source) | groq (free API) | openai (paid)
STT_PROVIDER=mock
# TTS:  mock | piper (open-source) | fish (paid, cheap) | elevenlabs (paid)
TTS_PROVIDER=mock
# LLM:  mock | ollama (open-source) | gemini (free API) | anthropic | openai
LLM_PROVIDER=mock
# Embeddings: hash (mock) | ollama | sentence_transformers | gemini (free) | openai
EMBEDDING_PROVIDER=hash

# ---- Free-tier API keys (great for a zero-cost cloud deploy) ----
# Gemini  — free key: https://aistudio.google.com/apikey   (LLM + embeddings)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=text-embedding-004
# Groq    — free key: https://console.groq.com             (Whisper STT)
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

# A fully-free real-AI cloud setup:
#   LLM_PROVIDER=gemini   EMBEDDING_PROVIDER=gemini   STT_PROVIDER=groq
#   (+ GEMINI_API_KEY and GROQ_API_KEY above)

# ---- Paid API keys (only needed if you select a paid provider above) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Fish Audio — key from https://fish.audio/app/developers
# ~10x cheaper than ElevenLabs (s1 $10 / s2-pro $15 per million UTF-8 bytes),
# and it returns WAV, so it also works for real phone calls (ElevenLabs' MP3
# does not). Models: s1 | s2-pro | s2.1-pro | s2.1-pro-free
FISH_API_KEY=
FISH_MODEL=s1
# Voice id from fish.audio (leave blank for the model's default voice).
FISH_VOICE_ID=
LLM_FAST_MODEL=claude-haiku-4-5-20251001
LLM_STRONG_MODEL=claude-opus-4-8

# ---- Open-source / local model settings ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
FASTER_WHISPER_MODEL=base.en
FASTER_WHISPER_DEVICE=cpu
PIPER_VOICE=en_US-amy-medium
PIPER_DATA_DIR=./piper_voices

# ---- Telephony (Twilio) — only for real phone calls ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---- Demo data ----
# A fresh install starts empty and opens the setup wizard, where you describe
# your own business (any industry). Set true to auto-load the sample business
# on startup instead — handy for a throwaway demo container. You can also load
# it on demand from the wizard's "Load sample data" link.
SEED_DEMO_DATA=false

# ---- Agent behaviour ----
VAD_SILENCE_MS=700
ESCALATION_CONFIDENCE_THRESHOLD=0.45
